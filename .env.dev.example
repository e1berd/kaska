POSTGRES_USER=hardhat
POSTGRES_PASSWORD=hardhat
POSTGRES_DB=hardhat_dev
POSTGRES_PORT=5432

API_PORT=4000
PHX_HOST=localhost
# Generate with: docker compose run --rm api mix phx.gen.secret
SECRET_KEY_BASE=replace_me_with_64_byte_secret
# Generate with: openssl rand -base64 64 | tr -d '\n'
GUARDIAN_SECRET_KEY=replace_me_with_64_byte_secret

# Mail (SMTP). Leave MAIL_HOST empty in dev to use Swoosh local mailbox at /mailbox.
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SSL=true
MAIL_FROM_ADDRESS=noreply@hardhat.local
MAIL_FROM_NAME=HardHat

WEB_PORT=5173
WEB_BASE_URL=http://localhost:5173
VITE_API_WS_URL=ws://localhost:4000/socket

RUSTFS_ROOT_USER=rustfsadmin
RUSTFS_ROOT_PASSWORD=rustfsadmin

S3_INTERNAL_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
