# =============================================================================
# HardHat — production .env template
# =============================================================================
# Скопируй этот файл в .env.production и заполни все значения.
# Запуск: docker compose --env-file .env.production up -d --build
# =============================================================================

# ----- Домены и SSL -----
# Лендинг (корневой домен).
LANDING_DOMAIN=example.com
# SPA + WebSocket API (Phoenix Channels).
APP_DOMAIN=app.example.com
# S3-совместимое хранилище (RustFS, доступ браузера к pre-signed URL).
S3_DOMAIN=s3.example.com
# Email для Let's Encrypt — на него придут уведомления о просроченных сертификатах.
ACME_EMAIL=admin@example.com

# Максимальный размер загрузки на S3 (для request_body в Caddy).
S3_MAX_UPLOAD_SIZE=100MB

# ----- Postgres -----
POSTGRES_USER=hardhat
POSTGRES_PASSWORD=__CHANGE_ME_TO_STRONG_PASSWORD__
POSTGRES_DB=hardhat

# ----- RustFS (S3) -----
RUSTFS_ROOT_USER=hardhat
RUSTFS_ROOT_PASSWORD=__CHANGE_ME_TO_STRONG_PASSWORD__
S3_BUCKET=hardhat
S3_INTERNAL_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=https://s3.example.com

# ----- Phoenix API -----
PHX_HOST=app.example.com
WEB_BASE_URL=https://app.example.com
# Сгенерируй: docker run --rm hardhat-api:latest bin/hardhat eval 'IO.puts(:crypto.strong_rand_bytes(64) |> Base.encode64())'
# Или: openssl rand -base64 64 | tr -d '\n'
SECRET_KEY_BASE=__GENERATE_64_BYTE_SECRET__
# Сгенерируй: openssl rand -base64 64 | tr -d '\n'
GUARDIAN_SECRET_KEY=__GENERATE_64_BYTE_SECRET__

# ----- SMTP (обязательно в prod) -----
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=__CHANGE_ME__
MAIL_SSL=true
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=HardHat

# ----- Web (build-time) -----
# WS endpoint для SPA — должен совпадать с APP_DOMAIN.
VITE_API_WS_URL=wss://app.example.com/socket
