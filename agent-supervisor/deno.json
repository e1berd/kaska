{
  "name": "@kaska/agent-supervisor",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read --allow-write=/var/run/docker.sock --allow-sys src/main.ts",
    "test": "deno test --allow-env src/",
    "check": "deno check src/main.ts && deno lint && deno fmt --check"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "dockerode": "npm:dockerode@^4.0.9"
  },
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "fmt": {
    "lineWidth": 100
  }
}
