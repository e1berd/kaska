{
  "name": "@kaska/agent-runtime",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "nodeModulesDir": "auto",
  "tasks": {
    "start": "deno run -A src/main.ts",
    "test": "deno test --allow-env --allow-read --allow-write --allow-run src/",
    "check": "deno check src/main.ts src/*_test.ts && deno lint && deno fmt --check"
  },
  "imports": {
    "@anthropic-ai/claude-agent-sdk": "npm:@anthropic-ai/claude-agent-sdk@0.3.273",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^0.93.0",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.29.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "zod": "npm:zod@^4.1.0"
  },
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "fmt": {
    "lineWidth": 100
  }
}
