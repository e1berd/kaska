---
const appUrl = 'https://app.kaska.space'
const title = 'Kaska — канбан-трекер задач для команд'
const description =
  'Kaska — самохостящийся канбан-трекер: доски, drag-and-drop, публичные read-only доски и развёртывание одной командой docker compose.'
const ogTitle = 'Kaska — канбан-трекер'
const ogDescription =
  'Самохостящийся канбан-трекер для команд: доски, drag-and-drop, публичные доски по ссылке, один docker-compose для развёртывания.'
const icon =
  "data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20viewBox%3D%270%200%20100%20100%27%3E%3Crect%20width%3D%27100%27%20height%3D%27100%27%20rx%3D%2722%27%20fill%3D%27%230061a4%27%2F%3E%3Cpath%20d%3D%27M28%2066V48a22%2022%200%200%201%2044%200v18Z%27%20fill%3D%27%23fff%27%2F%3E%3Crect%20x%3D%2718%27%20y%3D%2766%27%20width%3D%2764%27%20height%3D%2710%27%20rx%3D%273%27%20fill%3D%27%23fff%27%2F%3E%3Cpath%20d%3D%27M50%2024v10%27%20stroke%3D%27%23fff%27%20stroke-width%3D%274%27%20stroke-linecap%3D%27round%27%2F%3E%3C%2Fsvg%3E"

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Kaska',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description:
    'Самохостящийся канбан-трекер задач для команд. Публичные read-only доски, drag-and-drop, развёртывание через docker-compose.',
  license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'Realtime updates',
    'Public read access',
    'Self-hosted',
    'Drag-and-drop kanban',
    'Phoenix Channels',
  ],
}
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fdfcff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111416" media="(prefers-color-scheme: dark)" />
    <meta name="format-detection" content="telephone=no" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="kanban, трекер задач, self-hosted, phoenix, realtime, task tracker, agile, scrum"
    />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="author" content="Kaska" />

    <link rel="canonical" href={Astro.site} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kaska" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content={Astro.site} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />

    <link rel="icon" href={icon} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={icon} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body data-app-url={appUrl}>
    <a class="skip" href="#main">К содержимому</a>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fdfcff;
    --surface: #ffffff;
    --surface-2: #f4f6fb;
    --text: #1a1c1e;
    --muted: #44474a;
    --accent: #0061a4;
    --accent-on: #ffffff;
    --accent-soft: rgba(0, 97, 164, 0.08);
    --accent-shadow: rgba(0, 97, 164, 0.24);
    --border: #e1e2e6;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111416;
      --surface: #1a1c1e;
      --surface-2: #1f2426;
      --text: #e2e2e6;
      --muted: #c4c6ca;
      --accent: #9ecaff;
      --accent-on: #003258;
      --accent-soft: rgba(158, 202, 255, 0.12);
      --accent-shadow: rgba(158, 202, 255, 0.24);
      --border: #2a2c2f;
    }
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    padding: 0;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    line-height: 1.6;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  .skip {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .skip:focus {
    position: static;
    width: auto;
    height: auto;
    padding: 8px 12px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
</style>
